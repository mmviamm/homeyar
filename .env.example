# AI Studio Environment Configuration
GEMINI_API_KEY=

# دریافت خودکار اطلاعات از دیوار (اختیاری)
# کلید corsproxy.io (به‌صورت ?key=... به آدرس پراکسی اضافه می‌شود)
VITE_CORSPROXY_KEY=
# پراکسی اختصاصی؛ {url} با آدرس مقصد جایگزین می‌شود. مثال: https://my-proxy.example/?url={url}
VITE_DIVAR_PROXY_URL=
